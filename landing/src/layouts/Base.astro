---
import { url } from '../lib/url'

interface Props {
  title: string
  description?: string
}
const { title, description = 'PodDeck — Podcast slide decks generated by Claude Code' } = Astro.props
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-stone-50 text-stone-900 antialiased min-h-screen">
    <header class="border-b border-stone-200 bg-white">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href={url('/')} class="font-serif text-2xl tracking-tight">
          <span class="font-bold">Pod</span>Deck
        </a>
        <nav class="text-sm text-stone-600 space-x-6">
          <a href={url('/')} class="hover:text-stone-900">首页</a>
        </nav>
      </div>
    </header>
    <main class="max-w-6xl mx-auto px-6 py-10">
      <slot />
    </main>
    <footer class="mt-20 border-t border-stone-200 py-6 text-center text-xs text-stone-400 space-y-1">
      <div id="busuanzi_container_site_pv" style="display:none">
        本站总访问 <span id="busuanzi_value_site_pv"></span> 次 · 访客 <span id="busuanzi_value_site_uv"></span> 人
      </div>
      <div>PodDeck · 由 Claude Code 自动生成 · Slidev + Astro</div>
    </footer>
    <!-- 访问计数:Vercount(与不蒜子同元素 ID,国内可达)。is:inline 让 Astro 原样输出,不打包。 -->
    <script is:inline defer src="https://cn.vercount.one/js"></script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
  }
  html {
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
  }
  body {
    font-feature-settings: "cv11", "ss01";
  }
</style>
