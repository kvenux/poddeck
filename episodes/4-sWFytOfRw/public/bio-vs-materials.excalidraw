    {"id":"b1","type":"rectangle","x":30,"y":60,"width":320,"height":340,"angle":0,"strokeColor":"#0ca678","backgroundColor":"#d3f9d8","fillStyle":"hachure","strokeWidth":2,"strokeStyle":"solid","roughness":1.5,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":62,"version":1,"versionNonce":2,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t1","type":"text","x":50,"y":80,"width":290,"height":300,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":63,"version":1,"versionNonce":3,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":16,"fontFamily":1,"text":"You can encode it\nin a STRING:\n\nSMILES / SELFIES\n\nbecause you know:\n  - elements\n  - bonds\n\n→ that's almost\n   everything you\n   need.\n\n→ one model can\n   plausibly one-shot\n   a candidate.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"You can encode it\nin a STRING:\n\nSMILES / SELFIES\n\nbecause you know:\n  - elements\n  - bonds\n\n→ that's almost\n   everything you\n   need.\n\n→ one model can\n   plausibly one-shot\n   a candidate.","lineHeight":1.25,"baseline":294},
    {"id":"h2","type":"text","x":410,"y":20,"width":340,"height":30,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":64,"version":1,"versionNonce":4,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":22,"fontFamily":1,"text":"AI for materials (alloys)","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"AI for materials (alloys)","lineHeight":1.25,"baseline":22},
    {"id":"b2","type":"rectangle","x":400,"y":60,"width":340,"height":340,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"#ffe3e3","fillStyle":"hachure","strokeWidth":2,"strokeStyle":"solid","roughness":1.5,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":65,"version":1,"versionNonce":5,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"t2","type":"text","x":420,"y":80,"width":310,"height":310,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":66,"version":1,"versionNonce":6,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":16,"fontFamily":1,"text":"There IS no string.\n\nA real alloy is:\n  composition\n  + supply chain\n  + cost\n  + microstructure\n  + processing route\n     (additive vs cast)\n  + scale behavior\n  + qualification\n\n→ no model can\n   one-shot a material\n   that ends up in your\n   iPhone or on\n   Starship.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"There IS no string.\n\nA real alloy is:\n  composition\n  + supply chain\n  + cost\n  + microstructure\n  + processing route\n     (additive vs cast)\n  + scale behavior\n  + qualification\n\n→ no model can\n   one-shot a material\n   that ends up in your\n   iPhone or on\n   Starship.","lineHeight":1.25,"baseline":304}
